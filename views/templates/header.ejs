<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body{
      font-family:Tahoma,sans-serif;
      background:#c0c0c0;min-height:100vh;
      padding-bottom:40px
    }
    .navbar{background:#000080;
      border-bottom:2px solid #808080
    }
    .navbar-brand,.nav-link{
      color:#fff!important;
      font-size:13px
    }
    .nav-link:hover{
      color:#d4d0c8!important
    }
    .card{
      background:#fff;
      border:2px solid #808080;
      padding:20px;
      text-align:center;
      border-radius:0
    }
    h1,h2{color:#000080;
      font-size:18px
    }
    input{
      border:1px solid #808080!important;
      font-size:13px;
      border-radius:0!important
    }
    .btn-xp{
      background:#d4d0c8;
      border:2px solid #808080;
      color:#000;
      font-size:13px;
      font-family:Tahoma,sans-serif;
      width:100%;
      margin-top:6px;
      border-radius:0
    }
    .btn-xp:hover{
      background:#ece9d8
    }
    .btn-xp-sm{
      background:#d4d0c8;
      border:2px solid #808080;
      color:#000;
      font-size:11px;
      font-family:Tahoma,sans-serif;
      padding:2px 8px
    }
    .btn-xp-sm:hover{
      background:#ece9d8
    }
    .error{
      color:red;
      font-size:12px
    }
    a{
      color:#000080
    }
    .footer-bar{
      background:#000080;
      color:#fff;font-size:11px;
      padding:4px 12px;
      position:fixed;
      bottom:0;left:0;
      right:0;
      border-top:2px solid #808080
    }
    p{
      font-size:13px
    }
    .form-control{
      border-radius:0!important
    }
  </style>
</head>
<body>
<nav class="navbar navbar-expand-lg mb-4">
  <div class="container">
    <a class="navbar-brand" href="/">Members Club</a>
    <div class="navbar-nav ms-auto">
      <% if (locals.user) { %>
        <a class="nav-link" href="/members">Members Area</a>
        <% if (locals.isAdmin) { %>
          <a class="nav-link" href="/admin">Admin</a>
        <% } %>
        <a class="nav-link" href="/logout">Sign Out</a>
      <% } else { %>
        <a class="nav-link" href="/login">Log In</a>
        <a class="nav-link" href="/signup">Sign Up</a>
      <% } %>
    </div>
  </div>
</nav>